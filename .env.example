# Application
ZHQ_APP_NAME="智汇齐鲁·全域同频"
ZHQ_ENVIRONMENT=development
ZHQ_DEBUG=true
ZHQ_SECRET_KEY=replace-with-a-long-random-secret

# AI provider. Never commit a real key.
ZHQ_AI_PROVIDER=deepseek
ZHQ_AI_BASE_URL=https://api.deepseek.com
ZHQ_AI_MODEL=deepseek-chat
ZHQ_AI_API_KEY=
ZHQ_AI_CONNECT_TIMEOUT_SECONDS=10
ZHQ_AI_READ_TIMEOUT_SECONDS=60
ZHQ_AI_MAX_CONTEXT_MESSAGES=12

# 课表截图识别（视觉模型，不依赖本地 OCR 引擎）。留空则该功能返回 501 并提示配置。
# 实测 deepseek-flash + effort=low 最快（平均 4.03s / 中位 5.46s，准确率 100%）；
# mimo-v2.6-pro 平均 7.47s，mimo-v2.6-flash 平均 14.65s。provider 可切回 mimo。
ZHQ_VISION_PROVIDER=deepseek
ZHQ_VISION_EFFORT=low
ZHQ_VISION_TIMEOUT_SECONDS=120
ZHQ_VISION_MAX_TOKENS=16000
ZHQ_DEEPSEEK_VISION_BASE_URL=https://api.deepseek.com
ZHQ_DEEPSEEK_VISION_MODEL=deepseek-flash
ZHQ_DEEPSEEK_VISION_API_KEY=
# 备选视觉模型（ZHQ_VISION_PROVIDER=mimo 时生效）
ZHQ_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
ZHQ_MIMO_MODEL=mimo-v2.6-pro
ZHQ_MIMO_API_KEY=

# Future infrastructure adapters
ZHQ_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zhihui_qilu
ZHQ_REDIS_URL=redis://localhost:6379/0
ZHQ_WEB_ORIGIN=http://localhost:5173
ZHQ_MEMORY_BACKEND=memory
ZHQ_SQLITE_MEMORY_PATH=./data/zhihui_qilu_memory.sqlite3

# Memory retention
ZHQ_EPHEMERAL_MEMORY_TTL_SECONDS=14400
ZHQ_SHORT_TERM_MEMORY_TTL_SECONDS=604800
ZHQ_SECURITY_RATE_LIMIT_PER_MINUTE=60

# 复试现场的导师语音（Breeze Blue TTS）。留空则回落到浏览器语音合成。
# 实测：同步接口 13.08s / 流式首字节 2.00s，现场只走流式；完整音频落盘缓存。
ZHQ_BREEZE_BASE_URL=https://api.breeze.blue
ZHQ_BREEZE_API_KEY=
ZHQ_BREEZE_TTS_MODEL=breeze-tts-2
ZHQ_BREEZE_TIMEOUT_SECONDS=180
ZHQ_BREEZE_TTS_CACHE_DIR=./data/tts_cache
ZHQ_BREEZE_TTS_CACHE_ITEMS=400

# 复试现场的语音识别（小米 MiMo-ASR）。浏览器 Web Speech API 依赖 Google 服务，
# 国内连不上；换成这个之后转写稳定可用，实测字级命中 100%、端到端 2-3 秒。
ZHQ_MIMO_ASR_MODEL=mimo-v2.5-asr
ZHQ_MIMO_ASR_TIMEOUT_SECONDS=120
ZHQ_MIMO_ASR_MAX_BYTES=8388608