# Application
ZHQ_APP_NAME="智汇齐鲁·全域同频"
ZHQ_ENVIRONMENT=development
ZHQ_DEBUG=true
ZHQ_SECRET_KEY=replace-with-a-long-random-secret

# AI provider. Never commit a real key.
ZHQ_AI_PROVIDER=deepseek
ZHQ_AI_BASE_URL=https://api.deepseek.com
ZHQ_AI_MODEL=deepseek-chat
ZHQ_AI_API_KEY=
ZHQ_AI_CONNECT_TIMEOUT_SECONDS=10
ZHQ_AI_READ_TIMEOUT_SECONDS=60
ZHQ_AI_MAX_CONTEXT_MESSAGES=12

# Future infrastructure adapters
ZHQ_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zhihui_qilu
ZHQ_REDIS_URL=redis://localhost:6379/0
ZHQ_WEB_ORIGIN=http://localhost:5173
ZHQ_MEMORY_BACKEND=memory
ZHQ_SQLITE_MEMORY_PATH=./data/zhihui_qilu_memory.sqlite3

# Memory retention
ZHQ_EPHEMERAL_MEMORY_TTL_SECONDS=14400
ZHQ_SHORT_TERM_MEMORY_TTL_SECONDS=604800
ZHQ_SECURITY_RATE_LIMIT_PER_MINUTE=60
